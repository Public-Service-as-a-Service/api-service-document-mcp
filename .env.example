# --- Transport ------------------------------------------------------
# "http" (default) exposes MCP over Streamable HTTP for remote AI clients.
# "stdio" runs on stdin/stdout for local Claude Desktop / Inspector.
TRANSPORT=http
HTTP_PORT=3000

# Shared bearer token. The MCP server requires Authorization: Bearer <token>
# on every /mcp request. Required when TRANSPORT=http (fail-closed).
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Upstream document API -----------------------------------------
DOCUMENT_API_BASE_URL=http://innovationproject-apiservicedocument-kkftkt:3000
MUNICIPALITY_ID=2281

# "none"  — no Authorization header sent (innovation/dev setup).
# "oauth2" — client_credentials flow against OAUTH2_TOKEN_URL below.
DOCUMENT_API_AUTH_MODE=none
OAUTH2_TOKEN_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# --- Observability / features --------------------------------------
LOG_LEVEL=info

# Set to "true" to expose document/corpus statistics as MCP tools.
# Keep disabled for search-oriented clients; these are reporting tools
# with a different intended audience and usage pattern.
ENABLE_REPORTING_TOOLS=false
